# Cloudflare D1 is bound as DB by the Sites runtime.

# Required in production: base64-encoded 32-byte AES key used only to encrypt
# each signed-in user's own provider key. Never expose it in NEXT_PUBLIC_*.
AI_KEY_ENCRYPTION_SECRET=

# Single-account production access. Keep real values in hosted secrets only.
SLOWDAY_SITE_PASSWORD=
SLOWDAY_OWNER_ID=
SLOWDAY_OWNER_NAME=
